	[/component]

	[example title="WithIconSnippet"]
		<Notice {...args} title="Deploy warning" tone="warning">
			{#snippet icon(tone)}
				<span>{tone === 'warning' ? '⚠️' : 'ℹ️'}</span>
			{/snippet}
			The icon snippet receives the current tone as a parameter.
		</Notice>
	[/example]

	[example title="Repeated"]
		<Notice {...args} title="Connection retried" tone="danger" count={4}>
			The count prop renders an occurrence badge next to the title.
		</Notice>
	[/example]

	[example title="WithAction"]
		<Notice {...args} title="Update available" action={{ label: 'Restart now' }}>
			The action prop is a custom object type — see how it appears in the
