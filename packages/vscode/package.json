{
	"name": "sdocs",
	"displayName": "sdocs",
	"description": "Language support for sdocs — Svelte component documentation (.sdoc)",
	"version": "0.0.66",
	"publisher": "gabilungu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/gabilungu/sdocs",
		"directory": "packages/vscode"
	},
	"icon": "icons/sdocs-icon.png",
	"engines": {
		"vscode": "^1.101.0"
	},
	"categories": [
		"Programming Languages"
	],
	"extensionDependencies": [
		"svelte.svelte-vscode"
	],
	"activationEvents": [
		"onLanguage:svelte",
		"onLanguage:sdoc",
		"onLanguage:sdocs-config"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "sdoc",
				"aliases": [
					"sdoc"
				],
				"extensions": [
					".sdoc"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./icons/sdoc-light.svg",
					"dark": "./icons/sdoc-dark.svg"
				}
			},
			{
				"id": "sdocs-config",
				"aliases": [
					"sdocs config"
				],
				"filenames": [
					"sdocs.config.js",
					"sdocs.config.ts",
					"sdocs.config.mjs"
				],
				"icon": {
					"light": "./icons/mascot_mini.svg",
					"dark": "./icons/mascot_mini.svg"
				}
			}
		],
		"grammars": [
			{
				"language": "sdoc",
				"scopeName": "source.sdoc",
				"path": "./syntaxes/sdoc.tmLanguage.json",
				"embeddedLanguages": {
					"source.ts": "typescript",
					"source.js": "javascript",
					"source.css": "css",
					"source.svelte": "svelte",
					"text.html.markdown": "markdown",
					"meta.embedded.block.markdown": "markdown",
					"meta.embedded.expression.sdoc": "typescript"
				},
				"unbalancedBracketScopes": [
					"punctuation.definition.tag.begin.sdoc",
					"punctuation.definition.tag.end.sdoc"
				]
			},
			{
				"scopeName": "markdown.sdoc.codeblock",
				"path": "./syntaxes/sdoc-markdown.json",
				"injectTo": [
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.sdoc": "sdoc"
				}
			}
		],
		"commands": [
			{
				"command": "sdocs.newComponentDoc",
				"title": "sdocs: Create Component Documentation"
			},
			{
				"command": "sdocs.refreshScopes",
				"category": "sdocs",
				"title": "Refresh Projects",
				"icon": "$(refresh)"
			},
			{
				"command": "sdocs.refreshPreview",
				"category": "sdocs",
				"title": "Refresh sdocs Tab",
				"icon": "$(refresh)"
			},
			{
				"command": "sdocs.openInBrowser",
				"category": "sdocs",
				"title": "Open in Browser",
				"icon": "$(globe)"
			},
			{
				"command": "sdocs.restartServer",
				"category": "sdocs",
				"title": "Restart sdocs Server",
				"icon": "$(debug-restart)"
			}
		],
		"keybindings": [
			{
				"command": "sdocs.refreshPreview",
				"key": "ctrl+r",
				"mac": "cmd+r",
				"when": "activeWebviewPanelId == sdocsPreview"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "sdocs",
					"title": "sdocs",
					"icon": "icons/mascot_mono.svg"
				}
			]
		},
		"views": {
			"sdocs": [
				{
					"type": "webview",
					"id": "sdocsScopes",
					"name": "Projects",
					"icon": "icons/mascot_mono.svg"
				}
			]
		},
		"configuration": {
			"title": "sdocs",
			"properties": {
				"sdocs.scopes": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Extra project folders to offer in the sdocs view (workspace-relative or absolute paths). Useful in monorepos where detection misses a folder."
				}
			}
		},
		"menus": {
			"explorer/context": [
				{
					"command": "sdocs.newComponentDoc",
					"when": "resourceExtname == .svelte",
					"group": "2_workspace"
				}
			],
			"commandPalette": [
				{
					"command": "sdocs.newComponentDoc",
					"when": "resourceExtname == .svelte"
				},
				{
					"command": "sdocs.refreshPreview",
					"when": "activeWebviewPanelId == sdocsPreview"
				},
				{
					"command": "sdocs.restartServer",
					"when": "activeWebviewPanelId == sdocsPreview"
				},
				{
					"command": "sdocs.openInBrowser",
					"when": "activeWebviewPanelId == sdocsPreview"
				}
			],
			"editor/title": [
				{
					"command": "sdocs.refreshPreview",
					"when": "activeWebviewPanelId == sdocsPreview",
					"group": "navigation@1"
				},
				{
					"command": "sdocs.restartServer",
					"when": "activeWebviewPanelId == sdocsPreview",
					"group": "navigation@2"
				},
				{
					"command": "sdocs.openInBrowser",
					"when": "activeWebviewPanelId == sdocsPreview",
					"group": "navigation@3"
				}
			],
			"view/title": [
				{
					"command": "sdocs.refreshScopes",
					"when": "view == sdocsScopes",
					"group": "navigation"
				}
			]
		},
		"mcpServerDefinitionProviders": [
			{
				"id": "sdocs.mcp",
				"label": "sdocs"
			}
		]
	},
	"scripts": {
		"compile": "node esbuild.js",
		"watch": "node esbuild.js --watch",
		"package": "node esbuild.js --production",
		"vscode:prepublish": "npm run package",
		"test": "vitest run",
		"test:live": "node tests/integration/main.cjs"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/vscode": "^1.101.0",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^3.0.0",
		"esbuild": "^0.24.0",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^4.1.1",
		"sdocs": "file:../sdocs",
		"svelte-language-server": "^0.18.3",
		"typescript": "^5.7.0",
		"vitest": "^4.1.9",
		"vscode-languageclient": "^10.1.0",
		"vscode-languageserver": "^10.1.0",
		"vscode-languageserver-protocol": "^3.18.2",
		"vscode-languageserver-textdocument": "^1.0.13"
	}
}
