		args: {
			title: 'Build finished',
			tone: 'success',
			dismissible: true,
			count: 1,
		},
	};
</script>

{#snippet Default(args)}
	<Notice {...args}>
		All 12 pages compiled in 1.2s — try dismissing me, or change my props
