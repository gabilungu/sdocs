[DOC title="@explorer/Types"]


	Public TypeScript types exported from `sdocs`.

	```ts
	import type {
	  SdocsConfig,
	  ResolvedSdocsConfig,
	  AxisConfig,
	  ScaleConfig,
	  DocEntry,
	  PreviewEntry,
	  SdocMeta,
	  ComponentData,
	  ParsedProp,
	  ParsedMethod,
	  ParsedState,
	  ParsedCssProp,
	  ExtractedSnippet,
	  TocHeading,
	} from 'sdocs';
	```

	In the extracted API (`ParsedProp` and its siblings), fields that can be
	absent are typed as required-but-nullable (`string | null`), not
	TypeScript-optional — check for `null`, not for the key's presence.

	## `SdocsConfig`

	The user-facing config type — every field optional. This is the shape
	`sdocs.config.js` is checked against; see the
	[configuration reference](/explorer/configuration) for what each field means
	and what it defaults to.

	```ts
	interface SdocsConfig {
	  include?: string | string[];
	  port?: number;
	  open?: boolean;
	  css?: string | Record<string, string>;
	  static?: string;
	  outDir?: string;
	  title?: string;
	  logo?: string | false;
	  favicon?: string;
	  sections?: ({ slug: string; title?: string; order?: string[] } | { type: 'divider' })[];
	  home?: string;
	  routing?: 'history' | 'hash';
	  base?: string;
	  mcp?: boolean;
	  components?: string | string[];
	  axes?: AxisConfig[];
	  scale?: ScaleConfig;
	  content?: {
	    doc?: ContentSizing & { toc?: boolean; contentX?: string };
	    page?: ContentSizing & { contentX?: string };
	    showcase?: ContentSizing & { direction?: string; gap?: string; background?: string; minHeight?: string; contentX?: string; contentY?: string };
	    layout?: ContentSizing & { background?: string; minHeight?: string };
	  };
	}
	```

	```ts
	interface AxisConfig {
	  id: string;
	  label?: string;
	  values: string[];
	}

	interface ScaleConfig {
	  min?: number;
	  max?: number;
	  default?: number;
	  step?: number;
	  var?: string;
	  label?: string;
	  presets?: { label: string; value: number }[];
	}
	```

	Sidebar order lives on the **section** that owns it — `sections[].order` —
	rather than in a config key of its own. There is no top-level `sidebar`
	option.

	## `ResolvedSdocsConfig`

	What the loader returns: the same shape with every default applied, so
	nothing downstream has to re-derive one. `include` is always an array,
	`css` is `null` rather than absent when unset, and `content` carries a
	complete sizing block for each kind with its own `content` key (`doc`, `page`,
	`showcase`, `layout`).

	## `SdocMeta`

	An entity's metadata, read from its opener (`[SHOWCASE title="…"]`) and the
	`[NOTES]` and `[TODO]` blocks it holds. It is `DocEntry.meta`.

	```ts
	interface SdocMeta {
	  title: string;              // sidebar path, e.g. 'Demo / Button'
	  description?: string;
	  notes?: DocNote[];          // the entity's [NOTES]
	  todos?: TodoItem[];         // the entity's [TODO] checklist
	}
	```

	Only `title` is required.

	## `DocEntry`

	Each entity in a discovered `.sdoc` file becomes one `DocEntry` — a file
	with three entities yields three. These are what `virtual:sdocs` exports as
	`docs`.

	`kind` names the entity: `'component'` is a `[SHOWCASE]`, `'pattern'` a
	`[PATTERNS]`, and the rest match their tag.

	```ts
	interface DocEntry {
	  kind: 'component' | 'pattern' | 'doc' | 'page' | 'layout';
	  filePath: string;                 // absolute path to the .sdoc file
	  entitySlug: string;               // unique within the file
	  meta: SdocMeta;
	  entityScript?: string | null;     // entity-level <script>, shared by its blocks
	  entityStyle?: string | null;      // entity-level <style>
	  previews: PreviewEntry[];         // [COMPONENT] previews; empty otherwise
	  examples: ExtractedSnippet[];     // [EXAMPLE]s
	  content: ExtractedSnippet | null; // the body (doc, page, layout)
	  toc?: TocHeading[];               // doc only
	  maxWidth?: string;                // resolved content sizing
	  padding?: string;
	  contentX?: string;
	  showToc?: boolean;                // doc only
	  bodyTitle?: string;               // the body's # heading (doc only)
	  contentKey?: string;              // key into pageModules (doc, page)
	  prose: { key: string }[];         // [PROSE] blocks, keyed into pageModules
	  flow?: FlowItem[];                // body order of a [SHOWCASE] or [PATTERNS]
	  glossaries?: GlossaryBlock[];     // [GLOSSARY] blocks, in source order
	  routeSlug?: string;               // from slug="…"
	  hide?: boolean;                   // routable, never listed in a sidebar
	}

	interface PreviewEntry {
	  label: string;                       // tab label
	  componentName: string | null;
	  componentPath: string | null;        // absolute path to the component
	  componentData: ComponentData | null; // its extracted API
	  highlightedSource: string | null;    // highlighted component source HTML
	  args: Record<string, string | number | boolean | null>;
	  snippet: ExtractedSnippet;
	}

	interface TocHeading {
	  text: string;
	  level: number;
	  id: string;
	}
	```

	## `ComponentData`

	The extracted public API of a Svelte component.

	```ts
	interface ComponentData {
	  description?: string | null;      // the <!-- @component --> comment
	  descriptionHtml?: string;
	  props: ParsedProp[];
	  methods: ParsedMethod[];
	  state: ParsedState[];
	  cssProps: ParsedCssProp[];
	  acceptsClass?: boolean;           // merges `class` onto its root
	  forwardsRest?: boolean;           // spreads `...rest` onto its root
	  restType?: string | null;         // what the rest props are typed as
	  warnings?: string[];              // why extraction came back thin
	}
	```

	Events and snippets are not separate arrays — they live in `props`, tagged by
	`ParsedProp.category`, and are split out at render time.

	## `ParsedProp`

	```ts
	interface ParsedProp {
	  name: string;
	  type: string | null;
	  default: string | null;
	  description: string | null;
	  required: boolean;
	  category: 'prop' | 'event' | 'snippet';
	}
	```

	## `ParsedMethod`

	```ts
	interface ParsedMethod {
	  name: string;
	  params: string;              // parameter list source
	  returnType: string | null;
	  description: string | null;
	}
	```

	## `ParsedState`

	```ts
	interface ParsedState {
	  name: string;
	  type: string | null;
	  description: string | null;
	}
	```

	## `ParsedCssProp`

	```ts
	interface ParsedCssProp {
	  name: string;             // e.g. "--bg"
	  type: string | null;      // from @cssvar, e.g. "color" or "dimension"
	  default: string | null;
	  defaultUses?: { property: string; value: string }[]; // when var() fallbacks differ
	  description: string | null;
	}
	```

	## `ExtractedSnippet`

	```ts
	interface ExtractedSnippet {
	  name: string;             // preview label, example title, or 'Content'
	  slug: string;             // URL-safe id, unique within the entity
	  role: 'preview' | 'example' | 'content' | 'prose';
	  body: string;             // block body source
	  highlightedHtml?: string; // highlighted body HTML
	  previewUrl?: string;      // preview iframe URL (added by the virtual module)
	}
	```

	## See also

	- [Prop extraction](/explorer/features/prop-extraction) — what gets populated into these types
	- [Embedded usage](/explorer/embedded-vite) — consuming `virtual:sdocs`

[/DOC]
