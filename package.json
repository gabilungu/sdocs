{
	"name": "sdocs-monorepo",
	"private": true,
	"type": "module",
	"version": "0.0.0",
	"description": "Monorepo for sdocs — a lightweight documentation tool for Svelte 5 components",
	"license": "MIT",
	"workspaces": [
		"packages/sdocs",
		"apps/*"
	],
	"scripts": {
		"build": "npm run build -w sdocs",
		"dev": "npm run dev -w sdocs",
		"check": "npm run check -w sdocs",
		"test": "npm run test -w sdocs",
		"site:dev": "npm run dev -w site",
		"site:build": "npm run build -w site",
		"testapp:dev": "npm run dev -w testapp",
		"testapp:build": "npm run build -w testapp",
		"vscode:build": "npm run compile --prefix packages/vscode",
		"vscode:package": "npm run package --prefix packages/vscode"
	}
}
