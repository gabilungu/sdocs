{
	"name": "sdocs-monorepo",
	"private": true,
	"type": "module",
	"version": "0.0.0",
	"description": "Monorepo for sdocs \u2014 a lightweight documentation tool for Svelte 5 components",
	"license": "MIT",
	"workspaces": [
		"packages/sdocs",
		"apps/*"
	],
	"scripts": {
		"build": "npm run build -w sdocs",
		"dev": "npm run dev -w sdocs",
		"check": "npm run check -w sdocs",
		"test": "npm run test -w sdocs",
		"test:vscode": "npm test --prefix packages/vscode",
		"test:all": "npm run test -w sdocs && npm run test:vscode",
		"docs:dev": "npm run dev -w docs",
		"docs:build": "npm run build -w docs",
		"vscode:build": "npm run compile --prefix packages/vscode",
		"vscode:package": "npm run package --prefix packages/vscode"
	}
}
