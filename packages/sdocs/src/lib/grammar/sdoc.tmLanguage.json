{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "sdoc",
	"scopeName": "source.sdoc",
	"fileTypes": ["sdoc"],
	"patterns": [
		{ "include": "#comment" },
		{ "include": "#script-ts" },
		{ "include": "#script-js" },
		{ "include": "#style" },
		{ "include": "#docs" },
		{ "include": "#page" },
		{ "include": "#layout" }
	],
	"repository": {
		"comment": {
			"name": "comment.block.html.sdoc",
			"begin": "<!--",
			"end": "-->"
		},
		"script-ts": {
			"begin": "^\\s*(<)(script)(?=[^>]*lang=([\"'])ts\\3)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "entity.name.tag.script.sdoc" }
			},
			"end": "(</)(script)\\s*(>)",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "entity.name.tag.script.sdoc" },
				"3": { "name": "punctuation.definition.tag.end.sdoc" }
			},
			"patterns": [
				{ "include": "#tag-rest" },
				{
					"begin": "(?<=>)",
					"end": "(?=</script)",
					"contentName": "source.ts",
					"patterns": [{ "include": "source.ts" }]
				}
			]
		},
		"script-js": {
			"begin": "^\\s*(<)(script)(?![^>]*lang=([\"'])ts\\3)(?=[\\s>])",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "entity.name.tag.script.sdoc" }
			},
			"end": "(</)(script)\\s*(>)",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "entity.name.tag.script.sdoc" },
				"3": { "name": "punctuation.definition.tag.end.sdoc" }
			},
			"patterns": [
				{ "include": "#tag-rest" },
				{
					"begin": "(?<=>)",
					"end": "(?=</script)",
					"contentName": "source.js",
					"patterns": [{ "include": "source.js" }]
				}
			]
		},
		"style": {
			"begin": "^\\s*(<)(style)(?=[\\s>])",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "entity.name.tag.style.sdoc" }
			},
			"end": "(</)(style)\\s*(>)",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "entity.name.tag.style.sdoc" },
				"3": { "name": "punctuation.definition.tag.end.sdoc" }
			},
			"patterns": [
				{ "include": "#tag-rest" },
				{
					"begin": "(?<=>)",
					"end": "(?=</style)",
					"contentName": "source.css",
					"patterns": [{ "include": "source.css" }]
				}
			]
		},
		"tag-rest": {
			"begin": "\\G",
			"end": "(>)",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.end.sdoc" }
			},
			"patterns": [{ "include": "#attributes" }]
		},
		"docs": {
			"name": "meta.block.docs.sdoc",
			"begin": "^\\s*(\\[)(DOCS)\\b",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "keyword.control.entity.sdoc" }
			},
			"end": "^\\s*(\\[/)(DOCS)(\\])\\s*$",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "keyword.control.entity.sdoc" },
				"3": { "name": "punctuation.definition.tag.end.sdoc" }
			},
			"patterns": [
				{ "include": "#opener-attrs" },
				{ "include": "#comment" },
				{ "include": "#preview" },
				{ "include": "#example" }
			]
		},
		"page": {
			"name": "meta.block.page.sdoc",
			"begin": "^\\s*(\\[)(PAGE)\\b",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "keyword.control.entity.sdoc" }
			},
			"end": "^\\s*(\\[/)(PAGE)(\\])\\s*$",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "keyword.control.entity.sdoc" },
				"3": { "name": "punctuation.definition.tag.end.sdoc" }
			},
			"patterns": [
				{ "include": "#opener-attrs" },
				{ "include": "source.svelte" }
			]
		},
		"layout": {
			"name": "meta.block.layout.sdoc",
			"begin": "^\\s*(\\[)(LAYOUT)\\b",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "keyword.control.entity.sdoc" }
			},
			"end": "^\\s*(\\[/)(LAYOUT)(\\])\\s*$",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "keyword.control.entity.sdoc" },
				"3": { "name": "punctuation.definition.tag.end.sdoc" }
			},
			"patterns": [
				{ "include": "#opener-attrs" },
				{ "include": "source.svelte" }
			]
		},
		"preview": {
			"name": "meta.block.preview.sdoc",
			"begin": "^\\s*(\\[)(preview)\\b",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "entity.name.tag.sdoc" }
			},
			"end": "^\\s*(\\[/)(preview)(\\])\\s*$",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "entity.name.tag.sdoc" },
				"3": { "name": "punctuation.definition.tag.end.sdoc" }
			},
			"patterns": [
				{ "include": "#opener-attrs" },
				{ "include": "source.svelte" }
			]
		},
		"example": {
			"name": "meta.block.example.sdoc",
			"begin": "^\\s*(\\[)(example)\\b",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "entity.name.tag.sdoc" }
			},
			"end": "^\\s*(\\[/)(example)(\\])\\s*$",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.sdoc" },
				"2": { "name": "entity.name.tag.sdoc" },
				"3": { "name": "punctuation.definition.tag.end.sdoc" }
			},
			"patterns": [
				{ "include": "#opener-attrs" },
				{ "include": "source.svelte" }
			]
		},
		"opener-attrs": {
			"begin": "\\G",
			"end": "(\\])",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.end.sdoc" }
			},
			"patterns": [{ "include": "#attributes" }]
		},
		"attributes": {
			"patterns": [
				{
					"match": "([A-Za-z_][\\w-]*)\\s*(=)",
					"captures": {
						"1": { "name": "entity.other.attribute-name.sdoc" },
						"2": { "name": "punctuation.separator.key-value.sdoc" }
					}
				},
				{
					"match": "([A-Za-z_][\\w-]*)",
					"name": "entity.other.attribute-name.sdoc"
				},
				{
					"name": "string.quoted.double.sdoc",
					"begin": "\"",
					"end": "\"",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.string.begin.sdoc" }
					},
					"endCaptures": {
						"0": { "name": "punctuation.definition.string.end.sdoc" }
					}
				},
				{ "include": "#expression" }
			]
		},
		"expression": {
			"name": "meta.embedded.expression.sdoc",
			"begin": "\\{",
			"end": "\\}",
			"beginCaptures": {
				"0": { "name": "punctuation.section.embedded.begin.sdoc" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.section.embedded.end.sdoc" }
			},
			"patterns": [{ "include": "#expression-inner" }]
		},
		"expression-inner": {
			"patterns": [
				{
					"begin": "\\{",
					"end": "\\}",
					"patterns": [{ "include": "#expression-inner" }]
				},
				{ "include": "source.ts" }
			]
		}
	}
}
