{
	"compilerOptions": {
		"target": "ES2022",
		"module": "node18",
		"lib": ["ES2022"],
		"moduleResolution": "node16",
		"strict": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
