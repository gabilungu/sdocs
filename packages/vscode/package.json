{
	"name": "sdocs",
	"displayName": "sdocs",
	"description": "Language support for sdocs — Svelte component documentation (.sdoc)",
	"version": "0.0.19",
	"publisher": "gabilungu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/gabilungu/sdocs",
		"directory": "packages/vscode"
	},
	"icon": "icons/sdocs-icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Programming Languages"
	],
	"extensionDependencies": [
		"svelte.svelte-vscode"
	],
	"activationEvents": [
		"onLanguage:svelte",
		"onLanguage:sdoc",
		"onLanguage:sdoc-page",
		"onLanguage:sdoc-layout",
		"onLanguage:sdocs-config"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "sdoc",
				"aliases": [
					"sdoc"
				],
				"extensions": [
					".sdoc"
				],
				"icon": {
					"light": "./icons/sdoc-light.svg",
					"dark": "./icons/sdoc-dark.svg"
				}
			},
			{
				"id": "sdoc-page",
				"aliases": [
					"sdoc (page)"
				],
				"filenamePatterns": [
					"*.page.sdoc"
				],
				"icon": {
					"light": "./icons/sdoc-page-light.svg",
					"dark": "./icons/sdoc-page-dark.svg"
				}
			},
			{
				"id": "sdoc-layout",
				"aliases": [
					"sdoc (layout)"
				],
				"filenamePatterns": [
					"*.layout.sdoc"
				],
				"icon": {
					"light": "./icons/sdoc-layout-light.svg",
					"dark": "./icons/sdoc-layout-dark.svg"
				}
			},
			{
				"id": "sdocs-config",
				"aliases": [
					"sdocs config"
				],
				"filenames": [
					"sdocs.config.js",
					"sdocs.config.ts",
					"sdocs.config.mjs"
				],
				"icon": {
					"light": "./icons/mascot_mini.svg",
					"dark": "./icons/mascot_mini.svg"
				}
			}
		],
		"commands": [
			{
				"command": "sdocs.newComponentDoc",
				"category": "sdocs",
				"title": "New Component Doc"
			},
			{
				"command": "sdocs.refreshScopes",
				"category": "sdocs",
				"title": "Refresh Projects",
				"icon": "$(refresh)"
			},
			{
				"command": "sdocs.refreshPreview",
				"category": "sdocs",
				"title": "Refresh Docs Tab",
				"icon": "$(refresh)"
			}
		],
		"keybindings": [
			{
				"command": "sdocs.refreshPreview",
				"key": "ctrl+r",
				"mac": "cmd+r",
				"when": "activeWebviewPanelId == sdocsPreview"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "sdocs",
					"title": "sdocs",
					"icon": "icons/mascot_mono.svg"
				}
			]
		},
		"views": {
			"sdocs": [
				{
					"type": "webview",
					"id": "sdocsScopes",
					"name": "Projects",
					"icon": "icons/mascot_mono.svg"
				}
			]
		},
		"configuration": {
			"title": "sdocs",
			"properties": {
				"sdocs.scopes": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Extra project folders to offer in the sdocs view (workspace-relative or absolute paths). Useful in monorepos where detection misses a folder."
				}
			}
		},
		"menus": {
			"explorer/context": [
				{
					"command": "sdocs.newComponentDoc",
					"when": "resourceExtname == .svelte",
					"group": "2_workspace"
				}
			],
			"commandPalette": [
				{
					"command": "sdocs.newComponentDoc",
					"when": "resourceExtname == .svelte"
				},
				{
					"command": "sdocs.refreshPreview",
					"when": "activeWebviewPanelId == sdocsPreview"
				}
			],
			"editor/title": [
				{
					"command": "sdocs.refreshPreview",
					"when": "activeWebviewPanelId == sdocsPreview",
					"group": "navigation"
				}
			],
			"view/title": [
				{
					"command": "sdocs.refreshScopes",
					"when": "view == sdocsScopes",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"compile": "node esbuild.js",
		"watch": "node esbuild.js --watch",
		"package": "node esbuild.js --production",
		"vscode:prepublish": "npm run package"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/vscode": "^1.90.0",
		"@vscode/vsce": "^3.0.0",
		"esbuild": "^0.24.0",
		"typescript": "^5.7.0"
	}
}
