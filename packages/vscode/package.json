{
	"name": "sdocs",
	"displayName": "sdocs",
	"description": "Language support for sdocs — Svelte component documentation (.sdoc)",
	"version": "0.0.14",
	"publisher": "gabilungu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/gabilungu/sdocs",
		"directory": "packages/vscode"
	},
	"icon": "icons/sdocs-icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Programming Languages"
	],
	"extensionDependencies": [
		"svelte.svelte-vscode"
	],
	"activationEvents": [
		"onLanguage:svelte"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "svelte",
				"extensions": [
					".sdoc"
				]
			}
		]
	},
	"scripts": {
		"compile": "node esbuild.js",
		"watch": "node esbuild.js --watch",
		"package": "node esbuild.js --production",
		"vscode:prepublish": "npm run package"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/vscode": "^1.90.0",
		"@vscode/vsce": "^3.0.0",
		"esbuild": "^0.24.0",
		"typescript": "^5.7.0"
	}
}
