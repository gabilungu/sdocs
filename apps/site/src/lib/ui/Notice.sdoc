{/snippet}

{#snippet WithIconSnippet(args)}
	<Notice {...args} title="Deploy warning" tone="warning">
		{#snippet icon(tone)}
			<span>{tone === 'warning' ? '⚠️' : 'ℹ️'}</span>
		{/snippet}
		The icon snippet receives the current tone as a parameter.
	</Notice>
{/snippet}

{#snippet Repeated(args)}
	<Notice {...args} title="Connection retried" tone="danger" count={4}>
		The count prop renders an occurrence badge next to the title.
	</Notice>
{/snippet}

{#snippet WithAction(args)}
