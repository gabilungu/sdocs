<script lang="ts">
	import NoticeJs from "./NoticeJs.svelte";
	import Notice from "./Notice.svelte";
</script>

[SHOWCASE
	title="@demo/NoticeJs"
	description="The plain-JavaScript twin of Notice: the same full feature surface documented through JSDoc (@typedef + @property) instead of TypeScript — compare the two pages."
]

	[preview
		component={NoticeJs}
		args={{ title: 'Build finished', tone: 'success', dismissible: true, count: 1 }}
	]
		<NoticeJs {...args}>
			Documented entirely with JSDoc — types, descriptions, events, and snippets
			all come from the annotations.
		</NoticeJs>
	[/preview]

	[preview component={Notice}]
		<Notice {...args}>Something here</Notice>
	[/preview]


	[example title="WithIconSnippet"]
		<NoticeJs title="Deploy warning" tone="warning">
			{#snippet icon(tone)}
				<span>{tone === "warning" ? "⚠️" : "ℹ️"}</span>
			{/snippet}
			The icon snippet receives the current tone as a parameter.
		</NoticeJs>
	[/example]

	

	[example title="WithAction"]
		<NoticeJs {...args} title="Update available" action={{ label: "Restart now" }}>
			The action prop is a custom JSDoc typedef — it appears by name in the Props
			table.
		</NoticeJs>
	[/example]
	[example title=""]
		<div></div>
	[/example]
[/SHOWCASE]

