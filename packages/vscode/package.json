{
	"name": "sdocs",
	"displayName": "sdocs",
	"description": "Language support for sdocs — Svelte component documentation (.sdoc)",
	"version": "0.0.16",
	"publisher": "gabilungu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/gabilungu/sdocs",
		"directory": "packages/vscode"
	},
	"icon": "icons/sdocs-icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Programming Languages"
	],
	"extensionDependencies": [
		"svelte.svelte-vscode"
	],
	"activationEvents": [
		"onLanguage:svelte"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "svelte",
				"extensions": [
					".sdoc"
				]
			}
		],
		"commands": [
			{
				"command": "sdocs.newComponentDoc",
				"category": "sdocs",
				"title": "New Component Doc"
			},
			{
				"command": "sdocs.openScope",
				"category": "sdocs",
				"title": "Open in sdocs",
				"icon": "$(play)"
			},
			{
				"command": "sdocs.stopScope",
				"category": "sdocs",
				"title": "Stop",
				"icon": "$(debug-stop)"
			},
			{
				"command": "sdocs.openScopeExternal",
				"category": "sdocs",
				"title": "Open in Browser",
				"icon": "$(link-external)"
			},
			{
				"command": "sdocs.refreshScopes",
				"category": "sdocs",
				"title": "Refresh Projects",
				"icon": "$(refresh)"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "sdocs",
					"title": "sdocs",
					"icon": "icons/activity.svg"
				}
			]
		},
		"views": {
			"sdocs": [
				{
					"id": "sdocsScopes",
					"name": "Projects",
					"icon": "icons/activity.svg"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "sdocsScopes",
				"contents": "No sdocs projects found in this workspace.\nA project is a folder with an sdocs.config file or .sdoc files.\n[Learn more](https://gabilungu.github.io/sdocs/)"
			}
		],
		"configuration": {
			"title": "sdocs",
			"properties": {
				"sdocs.scopes": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Extra project folders to offer in the sdocs view (workspace-relative or absolute paths). Useful in monorepos where detection misses a folder."
				}
			}
		},
		"menus": {
			"explorer/context": [
				{
					"command": "sdocs.newComponentDoc",
					"when": "resourceExtname == .svelte",
					"group": "2_workspace"
				}
			],
			"commandPalette": [
				{
					"command": "sdocs.newComponentDoc",
					"when": "resourceExtname == .svelte"
				},
				{
					"command": "sdocs.openScope",
					"when": "false"
				},
				{
					"command": "sdocs.stopScope",
					"when": "false"
				},
				{
					"command": "sdocs.openScopeExternal",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "sdocs.refreshScopes",
					"when": "view == sdocsScopes",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "sdocs.openScope",
					"when": "view == sdocsScopes && viewItem == sdocs-scope",
					"group": "inline@1"
				},
				{
					"command": "sdocs.openScopeExternal",
					"when": "view == sdocsScopes && viewItem == sdocs-scope-running",
					"group": "inline@1"
				},
				{
					"command": "sdocs.stopScope",
					"when": "view == sdocsScopes && viewItem == sdocs-scope-running",
					"group": "inline@2"
				}
			]
		}
	},
	"scripts": {
		"compile": "node esbuild.js",
		"watch": "node esbuild.js --watch",
		"package": "node esbuild.js --production",
		"vscode:prepublish": "npm run package"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/vscode": "^1.90.0",
		"@vscode/vsce": "^3.0.0",
		"esbuild": "^0.24.0",
		"typescript": "^5.7.0"
	}
}
